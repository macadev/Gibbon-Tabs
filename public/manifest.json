{
  "manifest_version": 3,
  "name": "Gibbon Tabs",
  "author": "Daniel Macario",
  "version": "2.0.0",
  "description": "Gibbon Tabs",
  "icons": {
    "16": "images/logo.png",
    "48": "images/logo.png",
    "128": "images/logo.png"
  },
  "action": {
    "default_popup": "index.html"
  },
  "permissions": ["tabs", "storage"],
  "host_permissions": ["<all_urls>"]
}